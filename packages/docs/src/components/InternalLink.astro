---

export interface Props {
    slug: string;
}
const { slug } = Astro.props;

import { docList } from "./SiteNavigation";
import { trimEnd } from "../helpers/trimEnd";

// what is the requested doc?
const doc = docList.get(slug);
if (doc === undefined) {
    throw new Error("unable to find doc for slug '" + slug + "'");
}
const page = doc;

---

<span class="inline internal-link"><a class="imprint-link" href={"/" + slug}><span class="doc-title">{page.data.title}</span> - <span class="doc-description">{trimEnd(page.data.description, ".")}</span></a></span>
