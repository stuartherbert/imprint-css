---

import { getEntry } from "astro:content";

export interface Props {
    colorName: string;
    text?: string;
    fragment?: string;
}

const { colorName, text, fragment } = Astro.props;

const entry = await getEntry("colors", colorName);
if (entry === undefined) {
    throw new Error("no such named color '" + colorName + "'");
}

---

{text && <span class="inline internal-link"><a class="imprint-link" href={"/colors/" + entry.id + fragment}>{text}</a></span>}
{!text &&<span class="inline internal-link"><a class="imprint-link" href={"/colors/" + entry.id}><code class="doc-title">{entry.data.name}</code> (<code>{entry.data.definition}</code>)</a></span>}