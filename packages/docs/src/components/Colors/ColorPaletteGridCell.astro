---
import { getEntry } from "astro:content";


interface Props {
    colorName: string;
}

const { colorName } = Astro.props;

// load the color
// it's okay if the color doesn't exist
const colorData = await getEntry("colors", colorName);

let color = {
    hex: colorData?.data.hex || "var(--imprint-background)",
    color: colorData?.data.pairings.background || "var(--imprint-color)"
}

const swatchStyle = "background-color: " + color.hex + " !important; color: " + color.color + " !important;";

---
{colorData && <a href="" title="copy to clipboard" data-clipboard={colorName} class="relative !block !border-0 !hover:border-0 !active:border-0"><div style={swatchStyle}>&nbsp;</div></a>}
{!colorData && <div/>}