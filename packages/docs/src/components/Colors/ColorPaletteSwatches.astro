---
import ColorSwatch from "./ColorSwatch.astro";
import FixedHeightColorSwatch from "./FixedHeightColorSwatch.astro";
import { breakdownColorPalette } from "./ColorPalettes";

export interface Props {
    colorPalette: string;
    [name: string]: string;
}

const { colorPalette, ...attributes } = Astro.props;
const { defaultColor, regularPalette, alternatePalette } = await breakdownColorPalette(colorPalette);

---

{defaultColor && <FixedHeightColorSwatch colorName={defaultColor}/>}
<div {...attributes}>
    {regularPalette.map(({colorName, shortName}) => (
        <ColorSwatch colorName={colorName} shortName={shortName}/>
    ))}
</div>

{alternatePalette.length > 0 &&
<div {...attributes}>
    {alternatePalette.map(({colorName, shortName}) => (
        <ColorSwatch colorName={colorName} shortName={shortName}/>
    ))}
</div>
}