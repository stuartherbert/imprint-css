---
import { getEntry } from "astro:content";


export interface Props {
    colorName: string;
    shortName?: string;
}
const { colorName, shortName } = Astro.props;

const payload = await getEntry("colors", colorName );
if (payload === undefined) {
    throw new Error("no such color: " + colorName);
}

// shorthand
const color = payload?.data;
const swatchStyle = "background-color: " + color.hex + " !important; color: " + color.pairings.background + " !important;";

const displayName = shortName || color.name;

---

<div class="bg-white border rounded border-imprint-lightgray">
    <div class="m-2 rounded --standout-md">
        <a href={"/colors/" + colorName}>
            <div class="w-full aspect-[5/4]" style={swatchStyle}>
                <p>&nbsp;</p>
            </div>
        </a>
    </div>
    <div class="px-2 pb-2">
        <span class="block">
            <a href="" title="copy to clipboard" class="relative font-bold" data-clipboard={color.name}>{displayName}</a>
        </span>
        { shortName && <span class="block imprint-fontsize-minion">
                <a href="" title="copy to clipboard" class="relative" data-clipboard={color.hex.toUpperCase()}>{color.hex.toUpperCase()}
            </span>
            <span class="block pt-2 imprint-fontsize-minion">
                <a href={"/colors/" + color.name}>Info</a>
            </span>
        }
        { !shortName && <div class="flex justify-between pb-2 grow basis-1/2">
                <span class="block imprint-fontsize-minion">
                    <a href="" title="copy to clipboard" class="relative" data-clipboard={color.hex.toUpperCase()}>{color.hex.toUpperCase()}
                </span>
                <span class="block imprint-fontsize-minion">
                    <a href={"/colors/" + color.name}>Info</a>
                </span>
            </span>
        }
    </div>
</div>