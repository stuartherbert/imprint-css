---

import Callout from "../Callouts/Callout.astro";
import NoClearContrastWarning from "./NoClearContrastWarning.astro";
import { titleCase } from "../../helpers/titleCase";

export interface Props {
    colorName: string;
    lightOrDark: "light" | "dark";
    accessibilityDetails: {
        clearContrast: boolean;
        contrastRatio: number;
        wcagContrast: {
            A_normal: boolean;
            AA_normal: boolean;
            AA_large: boolean;
            AA_ui: boolean;
            AAA_normal: boolean;
            AAA_large: boolean;
        };
        recommendedForHeadings: boolean;
        passableForHeadings: boolean;
        recommendedForBodyContent: boolean;
        passableForBodyContent: boolean;
        passableForUi: boolean;
    }
}

const { colorName, lightOrDark, accessibilityDetails} = Astro.props;

// to simplfy the code below, we need to convert the accessibility data into
// a single value
let accessibilityCode = "";
if (accessibilityDetails.recommendedForHeadings) {
    accessibilityCode += "H1";
}
else if (accessibilityDetails.passableForHeadings) {
    accessibilityCode += "H2";
}
else if (accessibilityDetails.wcagContrast.AAA_large) {
    accessibilityCode += "h1";
}
else if (accessibilityDetails.wcagContrast.AA_large) {
    accessibilityCode += "h2";
}
if (accessibilityDetails.recommendedForBodyContent) {
    accessibilityCode += "B1";
}
else if (accessibilityDetails.passableForBodyContent) {
    accessibilityCode += "B2";
}
else if (accessibilityDetails.wcagContrast.AAA_normal) {
    accessibilityCode += "b1";
}
else if (accessibilityDetails.wcagContrast.AA_normal) {
    accessibilityCode += "b2";
}
if (accessibilityCode === "") {
    accessibilityCode = "ZZ";
}

console.log(accessibilityCode);

---

{ accessibilityCode == "H1B1" && (
    <Callout icon="success">
        <h4>This Color Is Very Accessible When Paired With A {titleCase(lightOrDark)} Color!</h4>

        <p><code>{colorName}</code> meets the <strong>WCAG 2.2 AAA standard for both headings and body text</strong> when paired with a {lightOrDark} color.</p>
        <p>You can safely use this color:</p>
        <ul>
            <li>as the text color for headings on a {lightOrDark} background,</li>
            <li>as the background color for {lightOrDark}-colored heading text.</li>
            <li>as the text color for body text on a {lightOrDark} background, or</li>
            <li>as the background color for {lightOrDark}-colored body text.</li>
        </ul>
        <p>Best of all, it isn't a {lightOrDark} or midtone color. It is a great choice for accessibility.</p>
        <p>We can't tell you if it is a <em>tasteful</em> color combination though. That's for you to decide!</p>
    </Callout>
)}

{ accessibilityCode === "H1B2" && (
    <Callout icon="success">
        <h4>This Color Is Very Accessible For Headings, And Fairly Accessible For Body Text (When Paired With A {titleCase(lightOrDark)} Color)</h4>

        <p><code>{colorName}</code> meets the <strong>WCAG 2.2 AAA standard for headings</strong> when paired with a {lightOrDark} color.</p>
        <p>You can safely use this color:</p>
        <ul>
            <li>as the text color for headings on a {lightOrDark} background, or</li>
            <li>as the background color for {lightOrDark}-colored heading text.</li>
        </ul>
        <p>It only meets the <strong>WCAG 2.2 AA standard for body text</strong> when paired with a {lightOrDark} color.</p>
        <p>You can get away with using it:</p>
        <ul>
            <li>as the text color for body text on a {lightOrDark} background, or</li>
            <li>as the background color for {lightOrDark}-colored body text,</li>
        </ul>
        <p>but other colors will be more accessible for partially-sighted readers.</p>
    </Callout>
)}

{ accessibilityCode === "H2B2" && (
    <Callout icon="success">
        <h4>This Color Is Fairly Accessible For Headings And Body Text (When Paired With A {titleCase(lightOrDark)} Color)</h4>

        <p><code>{colorName}</code> meets the WCAG 2.2 AA standard for headings and for body text when paired with a {lightOrDark} color.</p>

        <p>While you can use this color, other colors will be even better for partially-sighted readers.</p>
    </Callout>
)}

{ accessibilityCode === "h1b1" && (
    <Callout icon="warning">
        <h4>This Color Is Somewhat Accessible (When Paired With A {titleCase(lightOrDark)} Color)</h4>

        <p><code>{colorName}</code> does meet the <strong>WCAG 2.2 AAA standard for headings and body text</strong> when paired with a {lightOrDark} color.</p>
        <p>You could use it:</p>
        <ul>
            <li>as the text color for headings on a {lightOrDark} background,</li>
            <li>as the background color for {lightOrDark}-colored heading text,</li>
            <li>as the text color for body text on a {lightOrDark} background, or</li>
            <li>as the background color for {lightOrDark}-colored body text.</li>
        </ul>
        <NoClearContrastWarning colorName={colorName} lightOrDark={lightOrDark}/>
    </Callout>
)}

{ accessibilityCode === "h1b2" && (
