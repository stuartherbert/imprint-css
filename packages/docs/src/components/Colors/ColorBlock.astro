---
import { getEntry } from "astro:content";


export interface Props {
    colorName: string;
    shortName?: string;
}
const { colorName, shortName } = Astro.props;

const payload = await getEntry("colors", colorName );
if (payload === undefined) {
    throw new Error("no such color: " + colorName);
}

// shorthand
const color = payload?.data;
const swatchStyle = "background-color: " + color.hex + " !important; color: " + color.pairings.background + " !important;";

const displayName = shortName || color.name;

---

<nav>
<form method="GET" action={"/colors/" + color.name}>
    <button class="w-full px-4 py-4 --standout-md" style={swatchStyle}>
        <div class="flex justify-between grow-1">
            <span class="block">
                <a href="" class="font-bold">{displayName}</a>
            </span>
            <span class="block font-bold">
                <a href="">{color.hex.toUpperCase()}
            </span>
        </div>
    </button>
</form>
</nav>