---
import ColorBlock from "./ColorBlock.astro";
import ColorSwatch from "./ColorSwatch.astro";

export interface Props {
    colorName: string;
}
const { colorName } = Astro.props;

---

<div class="p-8 border rounded-lg grow shrink-0 border-imprint-valleyssun --shaded">
    <div class="mx-auto w-220rpx">
        <ColorSwatch colorName={colorName}/>
    </div>
</div>
<div class="docs-color-blocks-1">
    <div class="--standout-md">
        <ColorBlock colorName={colorName}/>
    </div>
</div>
