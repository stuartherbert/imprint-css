---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/page.astro";

export async function getStaticPaths() {
  const allColors = await getCollection("colors");

  return allColors.map((colorDetails) => {
    return {
      params: { color: colorDetails.id },
      props: { colorDetails }
    };
  });
}

const {colorDetails} = Astro.props;
const id = colorDetails.id;

const frontmatter = {
    title: colorDetails.data.title,
    description: colorDetails.data.description,
    navSection: colorDetails.data.navSection,
}
const origin = {
    collection: "colors",
    id: id,
}

import { colorDetails as mdxColorDetails, Content, getHeadings } from "../../layouts/color-analysis.mdx";
for (const key of Object.keys(colorDetails)) {
    mdxColorDetails[key] = colorDetails[key]
}
// console.log(mdxColorDetails)
// templateColorDetails.data = colorDetails.data;

---

<PageLayout frontmatter={frontmatter} origin={origin} headings={getHeadings()}>
    <Content/>
</PageLayout>