---
import type { Headings } from "../types/headings";

import bars3 from 'heroicons/24/solid/bars-3.svg?raw';
import xCircle from 'heroicons/24/outline/x-circle.svg?raw';

import Breadcrumb from "../components/Breadcrumb.astro";
import DebugCssBreakpoints from "../components/DebugCssBreakpoints.astro";
import SectionNavigation from "../components/SectionNavigation.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import PageToc from "../components/PageToc/PageToc.astro";
import PageTocOL from "../components/PageToc/PageTocOL.astro";
import InlineSvg from "../components/InlineSvg.astro";

export interface Props {
    frontmatter: {
        title: string;
        description: string;
        navSection: string;
        prev?: { collection: string; id: string } | undefined;
        next?: { collection: string; id: string } | undefined;
    }
    origin: {
        collection: string;
        id: string;
    }
    headings: Headings;
}

const {frontmatter, origin, headings} = Astro.props;
import "../styles/global.css";
import { getEntry } from "astro:content";
import PrevNextNavigation from "../components/PrevNextNavigation.astro";
import { trimEnd } from "../helpers/trimEnd";

const prev = frontmatter.prev ? await getEntry(frontmatter.prev) : undefined;
const next = frontmatter.next ? await getEntry(frontmatter.next) : undefined;

const pageTitle = `${frontmatter.title}: ${trimEnd(frontmatter.description, '.')} - Imprint CSS`;
---

<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{pageTitle}</title>
    </head>
    <body class="docs-content-grid">
        <DebugCssBreakpoints />
        <input id="show-hide-nav" type="checkbox" class="hidden"/>
        <div id="header" class="py-4 text-white bg-ganbaro-blue-500 docs-padding full-width">
            <div class="flex justify-between grow">
                <nav>
                    <a href="/" class="hover:underline hover:underline-offset-4">Imprint CSS<span class="hidden c:inline"> - Tailwind CSS plugin for content-oriented websites</span></a>
                </nav>
                <nav class="ml-auto justify-self-end">
                    <ul class="flex flex-row gap-4">
                        <li><a href="/docs" class="hover:underline hover:underline-offset-4">Docs</a></li>
                        <li><a href="https://oohshiny.dev" class="hover:underline hover:underline-offset-4">Blog</a></li>
                        <li><a href="https://github.com/stuartherbert/imprint-css" class="hover:underline hover:underline-offset-4">GitHub</a></li>
                    </ul>
                </nav>
            </div>
        </div>
        <div class="pb-2 border-b shadow-sm imprint pt-2 docs-padding border-imprint-valleyssun !bg-neutral-50 full-width z-50">
            <div class="flex items-center">
                <div class="pr-4 mr-4 border-r d:hidden border-imprint-valleyssun">
                    <label for="show-hide-nav"><InlineSvg id="open-show-hide-nav" svg={bars3} class="cursor-pointer w-24rpx h-24rpx"/><InlineSvg id="close-show-hide-nav" svg={xCircle} class="cursor-pointer w-24rpx h-24rpx"/></label>
                </div>
                <Breadcrumb origin={origin}/>
                <div id="hamburger-sidebar" class="hidden pt-2 pb-4 mt-0 docs-padding bg-imprint-shadedgray">
                    <div class="flex items-center pb-2 border-b border-imprint-valleyssun">
                        <div class="pr-4 mr-4 border-r border-imprint-valleyssun">
                            <label for="show-hide-nav"><InlineSvg id="close-show-hide-nav" svg={xCircle} class="cursor-pointer w-24rpx h-24rpx"/></label>
                        </div>
                        <Breadcrumb origin={origin}/>
                    </div>
                    <SiteNavigation/>
                </div>
            </div>
        </div>

        <div id="content" class="d:grid d-t:grid-cols-[17rem_1fr] d-d:grid-cols-[19rem_1fr]">
            <div id="sidebar-d" class="hidden pt-2 pb-4 border-b shadow-sm left-sidebar border-imprint-valleyssun d:border-r d:border-l docs-padding d:shadow-none d:border-b-0 d:overflow-y-auto d:sticky d:top-0 d:block d:pb-2 d:max-h-dvh d:border-imprint-valleyssun --shaded">
                <SiteNavigation/>
            </div>
            <div class="page">
                <div class="e:grid e:grid-cols-[1fr_17rem] e:gap-0 mb-10 e:mb-4 e:justify-center">
                    <div class="imprint-modern my-6 d:my-4 max-w-[80ch] content docs-padding">
                        <main role="main" class="">
                            <div class="mb-4 imprint-prose">
                                <header class="mt-4 mb-8 d:mt-2">
                                    <p class="!imprint-block-greatprimer !imprint-fontweight-greatprimer !text-imprint-darksteel">{frontmatter.navSection}</p>
                                    <h1 class="!mt-2">{frontmatter.title}</h1>
                                    {frontmatter.description && <p class="!imprint-block-greatprimer mt-2 font-light">{frontmatter.description}</p>}
                                </header>
                                <slot />
                            </div>
                            <PrevNextNavigation prev={prev} next={next}/>
                        </main>
                        <div id="compact" class="mt-6 mb-10 imprint e:hidden">
                            <div class="mb-4 imprint-panel --subtle bg-imprint-shadedgray border-imprint-valleyssun">
                                <div class="imprint-inner imprint-prose">
                                    <aside class="pb-4 mt-2 border-b d:hidden border-imprint-neutral">
                                        <h5 class="!text-20rpx !font-semibold mb-4">In {frontmatter.navSection}</h5>
                                        <SectionNavigation navSection={frontmatter.navSection}/>
                                    </aside>
                                    <aside class="pt-2 e:pt-0 e:mt-2">
                                        {headings.length > 0 &&
                                        <h5 class="!text-18rpx !font-semibold">On This Page</h5>
                                        <PageTocOL headings={headings} class=""/>
                                        }
                                    </aside>
                                </div>
                            </div>
                        </div>
                    </div>
                    {headings.length > 0 &&
                    <div id="pagetoc" class="sticky top-0 z-20 order-3 hidden px-4 pt-4 mt-2 overflow-y-auto border-x e:block border-imprint-valleyssun text-pica max-h-dvh">
                        <aside>
                            <h5 class="font-semibold text-18rpx">On This Page</h5>
                            <PageToc headings={headings}/>
                        </aside>
                    </div>
                    }
                </div>
            </div>
        </div>
        <div id="footer" class="px-4 py-4 text-white shadow full-width bg-ganbaro-blue-500">
            <div class="flex justify-center">
            <p>Copyright (c) 2024-present Ganbaro Digital Ltd.</p>
            </div>
        </div>

        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                function showCopiedTooltip(event, copyText) {
                    let tooltipElement = event.target.querySelector('.copied-tooltip');

                    if (!tooltipElement) {
                        tooltipElement = document.createElement("span");
                        tooltipElement.className = "copied-tooltip";
                        event.target.appendChild(tooltipElement);
                    }

                    // make all other visible tooltips hidden
                    document.querySelectorAll('.copied-tooltip').forEach((el) => {
                        el.style.visibility = "hidden";
                        el.style.opacity = "0";
                    });

                    tooltipElement.textContent ="Copied";
                    tooltipElement.style.visibility = "visible";
                    tooltipElement.style.opacity = "1";

                    setTimeout(function() {
                        tooltipElement.style.visibility = "hidden";
                        tooltipElement.style.opacity = "0";
                    }, 2000);
                }

                function copyToClipboard(event) {
                    event.preventDefault();
                    var target = event.target;
                    var copyText = target.dataset.clipboard;

                    if (navigator.clipboard?.writeText) {
                        navigator.clipboard.writeText(copyText);
                    }
                    else {
                        // Fallback for browsers that do not support the
                        // Clipboard API
                        const tempInput = document.createElement('input');
                        tempInput.style.position = 'fixed';
                        tempInput.style.left = '-9999px';
                        tempInput.value = copyText;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        tempInput.setSelectionRange(0, 99999);
                        document.execCommand('copy');
                        document.body.removeChild(tempInput);
                    }

                    // all done
                    showCopiedTooltip(event, copyText);
                }

                document.querySelectorAll("[data-clipboard]").forEach(
                    el => el.addEventListener("click", copyToClipboard)
                );
            });
            </script>
    </body>
</html>