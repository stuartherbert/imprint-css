{
    "name": "@imprintcss/color-collections",
    "version": "0.1.0",
    "description": "Collections of colors to use with CSS",
    "repository": {
        "type": "git",
        "url": "https://github.com/imprintcss/imprint-css"
    },
    "main": "lib/cjs/index.js",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "scripts": {
        "build": "npm run clean && tsc -b ./tsconfig-cjs.json ./tsconfig-esm.json ./tsconfig-types.json",
        "lint": "npx eslint .",
        "prepublishOnly": "npm run test",
        "prepack": "npm run build && npm run lint && rimraf lib/**/_*",
        "test": "npm run build && mocha",
        "cover": "npm run clean && c8 --cache=false npm run test",
        "clean": "rimraf coverage lib"
    },
    "contributors": [
        "Stuart Herbert <stuherbert@ganbarodigital.com> (https://ganbarodigital.com)"
    ],
    "keywords": [
        "colors",
        "longform",
        "imprint",
        "css"
    ],
    "files": [
        "lib/**/*",
        "CHANGELOG.md",
        "LICENSE.md"
    ],
    "author": "Stuart Herbert",
    "license": "BSD-3-Clause",
    "dependencies": {
        "@safelytyped/css-color": "^1.2.1",
        "@safelytyped/core-types": "^0.5.1",
        "@safelytyped/math-rounding": "^1.0.1"
    },
    "devDependencies": {
        "@types/chai": "^4.3",
        "@types/lodash": "^4.17.14",
        "@types/mocha": "^10.0",
        "@types/node": "^20.0",
        "@typescript-eslint/eslint-plugin": "^8.0",
        "@typescript-eslint/parser": "^8.0",
        "c8": "^10.0",
        "chai": "^4.3.0",
        "chai-bytes": "^0.1.2",
        "chai-string": "^1.5.0",
        "eslint": "^9.0",
        "lodash": "^4.17.21",
        "mocha": "^11.0",
        "rimraf": "^6.0.0",
        "startijenn-rem": "^1.1.1",
        "tailwindcss": "^3.4.0",
        "ts-node": "^10.9",
        "tsconfig-paths": "^4.2.0",
        "typedoc": "^0.27.0",
        "typescript": "^5.7"
    },
    "c8": {
        "all": true,
        "include": [
            "src/**/*.ts"
        ],
        "exclude": [
            "**/_fixtures/*",
            "**/*.spec.ts",
            "**/*.type.ts"
        ]
    }
}
